# FindBack AI — Environment Variables
# Copy this file to `.env` at the project root (used by backend/) and also
# create `frontend/.env.local` with the NEXT_PUBLIC_* values (see below).
# Never commit the real .env files — see Architecture Sec. 9 / SRS Sec. 9.

# --- App ---
ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# --- Supabase (Postgres + pgvector + Auth + Storage) ---
# Create a project at https://supabase.com, then fill these in from
# Project Settings > API and Project Settings > Database.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Auth ---
# "local"    — works with zero Supabase setup; good for Phase 0/1 dev
# "supabase" — real Supabase Auth; requires SUPABASE_URL,
#              SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_JWT_SECRET below,
#              plus running migrations/002_auth_trigger.sql
AUTH_MODE=local
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
# From Supabase: Project Settings > API > JWT Settings > JWT Secret
# (this is NOT the anon key or the service role key)
SUPABASE_JWT_SECRET=

# --- Storage ---
STORAGE_BUCKET=reports
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_REPORT=3
# Used only when Supabase Storage isn't configured above — local-disk
# fallback for uploaded images (Phase 3), served at BACKEND_BASE_URL/media.
LOCAL_STORAGE_DIR=./local_storage
BACKEND_BASE_URL=http://localhost:8000

# --- AI / Models (Phase 3 image pipeline is live; Phase 4 text pipeline is not) ---
MODEL_CACHE_DIR=./.model_cache
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CATEGORY_CONFIDENCE_THRESHOLD=0.35
# Set to false to force the deterministic non-ML fallback in
# app/services/vision.py even if torch/open_clip are installed.
ENABLE_IMAGE_AI=true

# --- Matching weights (SRS FR-08.1) — tunable without a code change ---
WEIGHT_IMAGE=0.40
WEIGHT_TEXT=0.20
WEIGHT_CATEGORY=0.10
WEIGHT_COLOR=0.10
WEIGHT_LOCATION=0.10
WEIGHT_TIME=0.05
WEIGHT_OTHER=0.05

# --- Thresholds ---
MATCH_NOTIFICATION_THRESHOLD=70
EXPLANATION_COMPONENT_THRESHOLD=60
DUPLICATE_SIMILARITY_THRESHOLD=90
TOP_K_MATCHES=5

# --- Frontend-only (also copy these into frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
