# Copy this to backend/.env for local development.
# See /.env.example at the project root for the full annotated reference.
ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/findback
AUTH_MODE=local
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=["http://localhost:3000"]

# Fill these in and set AUTH_MODE=supabase once you have a Supabase project
# (see /.env.example at the project root for where each value comes from):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
